  "sequence": [
    {
      "step": "Reset the stack pointer to $FF",
      "source": "Kernal.asm:1114"
    },
    {
      "step": "KernalInit — probe and initialize every card, interrupts still disabled",
      "source": "Kernal.asm:1115"
    },
    {
      "step": "Beep — guarded, skipped when no SID is fitted",
      "source": "Kernal.asm:1117"
    },
    {
      "step": "If BOOT_VECTOR ($035B) is non-zero, jmp through it (cartridge takeover)",
      "source": "Kernal.asm:1123"
    },
    {
      "step": "Halt if neither video nor serial is present — there is no console to boot into",
      "source": "Kernal.asm:1128"
    },
    {
      "step": "Mark BASIC cold, so the header prints and the variables clear; the program at $0800 is kept",
      "source": "Kernal.asm:1135"
    },
    {
      "step": "cli, then into BASIC, which prints the header on whichever console this machine has",
      "source": "Kernal.asm:1148"
