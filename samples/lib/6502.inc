; ===========================================================================
;   6502.inc — Kernal API and hardware constants for the AC6502 family
; ===========================================================================
;
;   BIOS       : v1.5
;   CPU        : WDC 65C02S
;   Assembler  : ca65 (cc65 toolchain)
;
;   GENERATED by scripts/extract-facts.mjs from the BIOS source. Do not edit;
;   change the BIOS and re-run `npm run facts`.
;
;   This is the docs' own copy, used to assemble the samples under samples/.
;   Reader-facing projects use the equivalent file shipped with the 6502-PRG
;   and 6502-CRT templates.
; ===========================================================================

; ===========================================================================
;   KERNAL JUMP TABLE — call the slot, not the implementation
; ===========================================================================

; --- Character I/O ---
Chrout              := $A000    ; Output char (dispatched by IO_MODE)
Chrin               := $A003    ; Input char from buffer
WriteBuffer         := $A006    ; Write byte to input buffer
ReadBuffer          := $A009    ; Read byte from input buffer
BufferSize          := $A00C    ; Get buffer count

; --- IO Mode ---
SetIOMode           := $A00F    ; Set IO_MODE
GetIOMode           := $A012    ; Get IO_MODE

; --- Video (TMS9918) ---
InitVideo           := $A015    ; Initialize TMS9918 (mode registers + character set)
VideoClear          := $A018    ; Clear video screen
VideoPutChar        := $A01B    ; Write char at cursor
VideoSetCursor      := $A01E    ; Set cursor (X=col, Y=row)
VideoGetCursor      := $A021    ; Get cursor position
VideoScroll         := $A024    ; Scroll screen up one line
VideoSetColor       := $A027    ; Set TMS9918 text color (A=reg7 byte: hi=fg, lo=bg)
VideoChroutRaw      := $A02A    ; Output char to video (raw, no control-code handling)

; --- Sound (SID) ---
InitSID             := $A02D    ; Initialize SID
Beep                := $A030    ; Play beep tone
SidPlayNote         := $A033    ; Play note (A=voice, X=freqLo, Y=freqHi)
SidSilence          := $A036    ; Silence all voices
SidSetVolume        := $A039    ; Set SID master volume (A=0-15)

; --- Filesystem ---
FsLoadFile          := $A03C    ; Load file from CF
FsSaveFile          := $A03F    ; Save file to CF
FsDeleteFile        := $A042    ; Delete file from CF

; --- Keyboard / GPIO ---
InitKB              := $A045    ; Initialize GPIO/VIA keyboard
ReadJoystick1       := $A048    ; Read joystick 1
ReadJoystick2       := $A04B    ; Read joystick 2

; --- Serial (6551) ---
InitSC              := $A04E    ; Initialize serial 6551
SerialChrout        := $A051    ; Direct serial output (bypass IO_MODE)
XModemLoad          := $A054    ; Receive binary via XModem
XModemSave          := $A057    ; Send binary via XModem

; --- RTC (DS1511Y) ---
RtcReadTime         := $A05A    ; Read RTC time
RtcReadDate         := $A05D    ; Read RTC date
RtcWriteTime        := $A060    ; Set RTC time
RtcWriteDate        := $A063    ; Set RTC date
RtcReadNVRAM        := $A066    ; Read NVRAM byte
RtcWriteNVRAM       := $A069    ; Write NVRAM byte

; --- CompactFlash Storage ---
StReadSector        := $A06C    ; Read CF sector
StWriteSector       := $A06F    ; Write CF sector
StWaitReady         := $A072    ; Wait CF ready

; --- System ---
SysDelay            := $A075    ; Delay A=cnt_lo, X=cnt_hi centiseconds
KernalInit          := $A078    ; Initialize all hardware (caller must reset SP; no cli, no splash); rts when done
KernalVersion       := $A07B    ; Get BIOS version (A=major, X=minor)

; --- Disk banking / addressed storage ---
FsLoadFileAddr      := $A07E    ; Load named file to FS_IO_ADDR
FsSaveFileAddr      := $A081    ; Save FS_FILE_SIZE bytes from FS_IO_ADDR to named file
FsFormatDisk        := $A084    ; Zero the current disk's directory sector
FsSetDisk           := $A087    ; Select current CF disk (A=0-255)
FsGetDisk           := $A08A    ; Get current CF disk (A=disk)
FsPrintDisk         := $A08D    ; Print "DISK n" + CRLF via Chrout

; --- General output utilities (console = IO_MODE-routed via Chrout) ---
PrintStr            := $A090    ; Print NUL-terminated string (A=lo, Y=hi); clobbers A,Y,STR_PTR
PrintCRLF           := $A093    ; Print CR+LF
PrintDecU16         := $A096    ; Print unsigned 16-bit decimal (A=lo, X=hi), no leading zeros

; --- Keyboard encoder control (raw port access) ---
KBDisable           := $A099    ; Release both encoders and settle; ports free for raw read
KBEnable            := $A09C    ; Re-enable both encoders

; 32 reserved slots at $A09F-$A0FE — each is a bare RTS.

; ===========================================================================
;   ZERO PAGE
; ===========================================================================

; $003A-$00FF is free for your program.

ZP                  := $00
READ_PTR            := $00
WRITE_PTR           := $01
STR_PTR             := $02      ; through $03 — String pointer (2 bytes)
CF_BUF_PTR          := $24      ; through $25 — CF sector data buffer pointer (2 bytes)
CF_LBA              := $26      ; through $29 — CF 28-bit LBA address (4 bytes, little-endian)
XFER_PTR            := $2A      ; through $2B — Serial transfer data pointer (2 bytes)
DELAY_CNT           := $2C      ; through $2D — SysDelay 16-bit centisecond counter
MON_ADDR            := $2E      ; through $2F — Monitor current address (2 bytes)
XMODEM_BLK          := $36      ; XModem expected/current block number
XMODEM_CHK          := $37      ; XModem running checksum
XMODEM_RETRY        := $38      ; XModem retry counter
XMODEM_RCVBLK       := $39      ; XModem received block number
MON_END             := $30      ; through $31 — Monitor end address (2 bytes)
MON_TMP             := $32      ; through $33 — Monitor temp pointer (2 bytes)
MON_BYTE            := $34      ; Monitor parsed byte scratch
MON_IDX             := $35      ; Monitor input line index

; ===========================================================================
;   KERNAL VARIABLES ($0300-$03FF)
; ===========================================================================
KERNAL_VARS         := $0300    ; through $03FF
IRQ_PTR             := $0300    ; through $0301
BRK_PTR             := $0302    ; through $0303
NMI_PTR             := $0304    ; through $0305
IO_MODE             := $0306    ; Bit 0: 0=video, 1=serial output
VID_CURSOR_X        := $0307    ; Video cursor column (0-39)
VID_CURSOR_Y        := $0308    ; Video cursor row (0-23)
VID_CURSOR_ADDR     := $0309    ; Video cursor VRAM address ($0309-$030A)
RTC_BUF_CENT        := $030B    ; Century value from last RtcReadDate / for RtcWriteDate
RTC_TMP             := $030C    ; Scratch byte for BCD conversion
HW_PRESENT          := $030D    ; Hardware present bitmask (set during Reset probe)
BAS_PENDKEY         := $030E    ; Pending key from BasCheckBreak (1 byte)
CF_DISK             := $030F    ; Current CF "disk" bank (0-255); base LBA = CF_DISK * FS_DISK_SECTORS
BRK_P               := $0310    ; Saved P at time of BRK
BRK_PCL             := $0311    ; Saved PCL at time of BRK (points to BRK+2)
BRK_PCH             := $0312    ; Saved PCH at time of BRK
BRK_A               := $0313    ; Saved A at time of BRK
BRK_X               := $0314    ; Saved X at time of BRK
BRK_Y               := $0315    ; Saved Y at time of BRK
BRK_SP              := $0316    ; Saved SP at time of BRK
XFER_REMAIN         := $0317    ; through $0318 — Remaining bytes to transfer (2 bytes)
XFER_IO_SAVE        := $0319    ; Saved IO_MODE before switching to serial
BAS_DATAPTR         := $031A    ; through $031B — DATA read position (2 bytes)
BAS_STOPLINE        := $031C    ; through $031D — Saved BAS_CURLINE for CONT (2 bytes)
BAS_STOPTXT         := $031E    ; through $031F — Saved BAS_TXTPTR for CONT (2 bytes)
SCROLL_BUF          := $0320    ; through $0347 — 40-byte scroll temp buffer
FS_START_SEC        := $0348    ; through $0349 — File start sector (2 bytes)
FS_FILE_SIZE        := $034A    ; through $034B — File size in bytes (2 bytes)
FS_SEC_COUNT        := $034C    ; Number of sectors to read/write
FS_DIR_IDX          := $034D    ; Directory entry index (0-15)
FS_NEXT_SEC         := $034E    ; through $034F — Next free sector for allocation (2 bytes)
FS_FNAME_BUF        := $0350    ; through $035A — 11-byte filename buffer (8 name + 3 ext)
BOOT_VECTOR         := $035B    ; through $035C — Cart/boot redirect vector (2 bytes, 0=normal boot)
BAS_TXTTAB          := $035D    ; through $035E — Start of program text (= $0800)
BAS_VARTAB          := $035F    ; through $0360 — End-of-program / start-of-vars pointer
BAS_ARYTAB          := $0361    ; through $0362 — Start of arrays
BAS_STREND          := $0363    ; through $0364 — End of arrays
BAS_FRETOP          := $0365    ; through $0366 — Top-of-string-heap pointer
BAS_MEMSIZ          := $0367    ; through $0368 — End of usable memory (= $8000)
BAS_CURLIN          := $0369    ; through $036A — Currently executing line ($FFFF=direct mode)
BAS_OLDLIN          := $036B    ; through $036C — Saved line for CONT
BAS_OLDTEXT         := $036D    ; through $036E — Saved text ptr for CONT
BAS_WARM            := $036F    ; Warm-start magic ($A5 = previously initialized)
BAS_POSX            := $0370    ; PRINT column counter (0-39 video / 0-79 serial)
BAS_INPSAV          := $0371    ; through $0372 — Saved TXTPTR across INPUT REDO retry
BAS_FNPTR           := $0373    ; through $0374 — FN variable slot addr held across FnCall's expression evaluations (out of ZP so FrmEvl/Garbag cannot touch it)
BAS_STKBASE         := $0375    ; Stack pointer the READY loop restores before each direct-mode line: $FF with no
FS_IO_ADDR          := $037F    ; through $0380 — Load/save target address for FsLoadFileAddr/FsSaveFileAddr
BAS_FNAME           := $0381    ; through $038D — 13-byte scratch for null-terminated 8.3 filename (12-char "NAME.EXT" + null)
PRG_IMAGE_END       := $038E    ; through $038F — End address of a program image placed at PROGRAM_START by a loader

; ===========================================================================
;   KEY MEMORY LOCATIONS
; ===========================================================================
STACK               := $0100    ; CPU stack
INPUT_BUFFER        := $0200    ; Keyboard ring buffer
USER_VARS           := $0400    ; BASIC line buffers
FS_SECTOR_BUF       := $0600    ; CompactFlash sector buffer
PROGRAM_START       := $0800    ; Program RAM
MONITOR_ENTRY       := $EE00    ; Monitor cold entry
MONITOR_BRK_ENTRY   := $EE03    ; Monitor BRK entry (displays saved registers)
WOZMON              := $FF00    ; Apple I monitor

; ===========================================================================
;   HARDWARE DETECTION
; ===========================================================================

; Read $030D and guard your own code the way the Kernal guards its own.
HW_RAM_L             = %00000001 ; IO 1 — RAM Card
HW_RAM_H             = %00000010 ; IO 2 — RAM Card
HW_RTC               = %00000100 ; IO 3 — RTC Card
HW_CF                = %00001000 ; IO 4 — Storage Card
HW_SC                = %00010000 ; IO 5 — Serial Card
HW_GPIO              = %00100000 ; IO 6 — GPIO Card / Input Board
HW_SID               = %01000000 ; IO 7 — Sound Card
HW_VID               = %10000000 ; IO 8 — Video Card / VGA Card

; ===========================================================================
;   IO HARDWARE REGISTERS
; ===========================================================================

; --- IO 1 | RAM Card | $8000-$83FF ---
