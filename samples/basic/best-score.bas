10 REM BEST SCORE, KEPT IN A SAVE SLOT
20 G = 42 : A = 20000 : B = 0
30 S = NVFIND(G)
40 IF S < 0 THEN S = NVFIND(0) : GOTO 90
50 IF NVSTAT(S) = 2 THEN PRINT "THE LAST SAVE WAS DAMAGED" : NVERASE S : GOTO 90
60 NVLOAD S, A
70 B = PEEK(A) * 256 + PEEK(A + 1)
90 IF S < 0 THEN PRINT "EVERY SLOT IS TAKEN" : END
100 PRINT "BEST SO FAR:"; B
110 INPUT "YOUR SCORE"; P
120 IF P <= B THEN PRINT "NOT THIS TIME" : END
130 POKE A, INT(P / 256) : POKE A + 1, P - INT(P / 256) * 256
140 NVSAVE S, G, A
150 PRINT "A NEW BEST, IN SLOT"; S
