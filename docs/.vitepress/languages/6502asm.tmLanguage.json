{
  "name": "6502asm",
  "scopeName": "source.6502asm",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#directives" },
    { "include": "#mnemonics" },
    { "include": "#numbers" },
    { "include": "#labels" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": ";.*$", "name": "comment.line.semicolon.6502asm" }
      ]
    },
    "strings": {
      "patterns": [
        { "match": "\"[^\"]*\"", "name": "string.quoted.double.6502asm" }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "(?i:\\.(byte|word|res|org|setcpu|macpack|import|export|segment|include|proc|endproc|scope|endscope|addr|a16|a8|i16|i8|feature|define|ifdef|ifndef|endif|macro|endmacro))",
          "name": "keyword.other.directive.6502asm"
        }
      ]
    },
    "mnemonics": {
      "patterns": [
        {
          "match": "(?i:\\b(ADC|AND|ASL|BBR0|BBR1|BBR2|BBR3|BBR4|BBR5|BBR6|BBR7|BBS0|BBS1|BBS2|BBS3|BBS4|BBS5|BBS6|BBS7|BCC|BCS|BEQ|BIT|BMI|BNE|BPL|BRA|BRK|BVC|BVS|CLC|CLD|CLI|CLV|CMP|CPX|CPY|DEC|DEX|DEY|EOR|INC|INX|INY|JMP|JSR|LDA|LDX|LDY|LSR|NOP|ORA|PHA|PHP|PHX|PHY|PLA|PLP|PLX|PLY|RMB0|RMB1|RMB2|RMB3|RMB4|RMB5|RMB6|RMB7|ROL|ROR|RTI|RTS|SBC|SEC|SED|SEI|SMB0|SMB1|SMB2|SMB3|SMB4|SMB5|SMB6|SMB7|STA|STP|STX|STY|STZ|TAX|TAY|TRB|TSB|TSX|TXA|TXS|TYA|WAI)\\b)",
          "name": "keyword.control.mnemonic.6502asm"
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "#?\\$[0-9A-Fa-f]+", "name": "constant.numeric.hex.6502asm" },
        { "match": "#?%[01]+", "name": "constant.numeric.binary.6502asm" },
        { "match": "#?\\b\\d+\\b", "name": "constant.numeric.decimal.6502asm" }
      ]
    },
    "labels": {
      "patterns": [
        { "match": "^[A-Za-z_][A-Za-z0-9_]*:", "name": "entity.name.function.label.6502asm" }
      ]
    }
  }
}
