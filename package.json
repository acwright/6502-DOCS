{
  "name": "6502-docs",
  "version": "1.5.2",
  "description": "User's and programmer's guide for the ACE, flagship of the AC6502 family.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "facts": "node scripts/extract-facts.mjs",
    "facts:check": "node scripts/extract-facts.mjs --check",
    "migrate": "node scripts/migrate-assets.mjs",
    "migrate:check": "node scripts/migrate-assets.mjs --check",
    "cards": "node scripts/build-cards.mjs",
    "cards:verify": "node scripts/build-cards.mjs --check",
    "cards:check": "node scripts/check-cards.mjs",
    "diagrams": "node scripts/build-diagrams.mjs",
    "diagrams:verify": "node scripts/build-diagrams.mjs --check",
    "embeds": "node scripts/build-embeds.mjs",
    "embeds:verify": "node scripts/build-embeds.mjs --check",
    "photos": "node scripts/import-photos.mjs",
    "photos:check": "node scripts/import-photos.mjs --check",
    "icons": "node scripts/build-icons.mjs",
    "icons:check": "node scripts/build-icons.mjs --check",
    "screens": "node scripts/capture-screens.mjs",
    "screens:verify": "node scripts/capture-screens.mjs --check",
    "preflight": "node scripts/preflight.mjs",
    "check:voice": "node scripts/check-voice.mjs",
    "links": "node scripts/check-links.mjs",
    "links:offline": "node scripts/check-links.mjs --offline",
    "verify": "node scripts/check-voice.mjs && node scripts/check-cards.mjs && node scripts/build-cards.mjs --check && node scripts/build-diagrams.mjs --check && node scripts/build-embeds.mjs --check && node scripts/import-photos.mjs --check && node scripts/verify-samples.mjs"
  },
  "devDependencies": {
    "@shikijs/core": "^2.5.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.24"
  }
}
